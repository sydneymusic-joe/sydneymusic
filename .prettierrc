{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
  "bracketSameLine": true,
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	],
	"tailwindStylesheet": "./src/app.css",
	"tailwindFunctions": ["twMerge"]
}
